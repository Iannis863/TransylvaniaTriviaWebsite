# Optional configuration for `npm run dev` (copies of this file contain no secrets).
# `npm run dev:local` ignores .env and uses disposable memory data instead.

# Leave empty for memory storage in development. Production requires PostgreSQL.
DATABASE_URL=

# Optional >=32-character override; otherwise production generates and persists
# its session secret in app_runtime_settings. Keep actual secrets out of Git.
# SESSION_SECRET=

# Required for real outgoing email; unset leaves queued deliveries pending.
# RESEND_API_KEY=

# Required for the protected scheduled-notification endpoint on Vercel.
# CRON_SECRET=

# Optional exact browser origin, with no trailing slash.
# APP_ORIGIN=https://transilvaniatrivia.ro

# Only for a self-hosted app behind a trusted single reverse proxy.
# Vercel proxy handling is automatic.
# TRUST_PROXY=1

# Optional custom PostgreSQL CA certificate, if required by your provider.
# DATABASE_CA_CERT=

# Optional sample accounts in ordinary development; not for production.
# SEED_DEMO_DATA=true
